__pycache__/
*.pyc
.env
*.egg-info/

# Build artifacts
build/
dist/
*.whl

# Private indexes (legacy global tree; new work lives under projects/)
indexes/private/*
!indexes/private/.gitignore

# Per-engagement projects (phrases + FAISS + public sources)
projects/*
!projects/.gitignore

# GUI last-selected project
config/project.json

# Logs, caches, run outputs
logs/
*.log
cache/
.cache/
results/

# Generated demo artifacts (examples create their own indexes/outputs)
examples/examples/
examples/output/
examples/indexes/
examples/cache/
examples/metrics.log
examples/fuzzing_results.json
