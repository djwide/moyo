{%- macro badge(label) -%}
{%- set key = (label or 'info')|string|lower|replace('_','-') -%}
<span class="badge badge--{{ key }}">{{ label }}</span>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>MOYO Exposure Snapshot · {{ content.meta.topic }}</title>
  <style>{{ css_text | safe }}</style>
</head>
<body>
  {# One-pager: no hyperlinks; CTAs are plain text only. #}
  <article class="onepage">
    <header class="brand-bar">
      <span>{% if logo_uri %}<img class="brand-bar__logo brand-bar__logo--moyo" src="{{ logo_uri }}" alt="MOYO" />{% endif %}</span>
      <span>{% if partner_logo_uri %}<img class="brand-bar__logo brand-bar__logo--partner" src="{{ partner_logo_uri }}" alt="SenTeGuard" />{% endif %}</span>
    </header>

    <div class="eyebrow">Exposure Snapshot</div>
    <p class="prompt-line">Prompt:
      {% if content.meta.prompts and content.meta.prompts|length > 1 %}
        {% for p in content.meta.prompts %}&ldquo;{{ p }}&rdquo;{% if not loop.last %}; {% endif %}{% endfor %}
      {% else %}&ldquo;{{ content.meta.prompts[0] if content.meta.prompts else content.meta.topic }}&rdquo;{% endif %}
    </p>
    <p class="date-line">{{ content.meta.report_date }}</p>
    <h1 class="headline">{{ content.meta.headline }}</h1>

    <div class="metrics">
      <div class="metric"><div class="value">{{ content.meta.counts.findings }}</div><div class="label">Findings</div></div>
      <div class="metric"><div class="value">{{ content.meta.counts.llms_tested }}</div><div class="label">LLMs Tested</div></div>
      <div class="metric"><div class="value">{{ content.meta.counts.high_sensitivity }}</div><div class="label">High-Sensitivity</div></div>
      <div class="metric"><div class="value">{{ content.meta.counts.chains }}</div><div class="label">Exposure Chains</div></div>
    </div>

    <div class="body-grid">
      <div class="col">
        <section class="panel">
          <h2>Most Significant Finding</h2>
          <p class="lead-finding">{{ content.top_finding.text }}</p>
          <p class="badges">{% for b in content.top_finding.badges or [] %}{{ badge(b) }}{% endfor %}</p>
        </section>
        <section class="panel">
          <h2>Specific Disclosures</h2>
          <ul class="specific-list">
            {% for f in content.specific_findings[:2] %}
            <li>
              <span class="mono">{{ f.claim_id }}</span>{{ badge('SPECIFIC') }}{% if f.status %}{{ badge(f.status) }}{% endif %}
              <span class="specific-claim">{{ f.claim }}</span>
              {% if f.source_cite %}<span class="specific-source">{{ f.source_cite }}</span>{% endif %}
              {% if f.citations_display %}<span class="specific-cited">Cited: {{ f.citations_display | map(attribute='short') | join('; ') }}</span>{% endif %}
            </li>
            {% else %}
            <li>No high-specificity findings in this run.</li>
            {% endfor %}
          </ul>
        </section>
      </div>
      <div class="col">
        <section class="panel">
          <h2>Severity</h2>
          <div class="chart">{{ content.charts.severity_donut_compact | safe }}</div>
        </section>
        <section class="panel">
          <h2>Full Assessment</h2>
          <p>{{ content.meta.counts.findings }} findings · {{ content.meta.counts.chains }} evidence chains · {{ content.meta.counts.llms_tested }} models</p>
          <ul class="teaser-list">
            <li>Complete finding index with evidence excerpts</li>
            <li>Model contribution and cited real-world sources</li>
            <li>Remediation playbook</li>
          </ul>
          {% if content.exec.public_sources %}
          <p class="panel-sources">Public sources: {{ content.exec.public_sources | join('; ') }}</p>
          {% endif %}
        </section>
      </div>
    </div>
  </article>
</body>
</html>
