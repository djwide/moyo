<section class="page page--sources" id="sources">
  <h2>{{ content.pages.sources.title or "Cited Sources" }}</h2>
  {% if content.sources %}
  <p class="section-lede">{{ content.pages.sources.lede | link_cites }}</p>
  <table class="source-table">
    <colgroup>
      <col class="col-ref" />
      <col class="col-label" />
      <col class="col-cited" />
    </colgroup>
    <thead>
      <tr>
        <th>Ref</th>
        <th>Source</th>
        <th>Findings</th>
      </tr>
    </thead>
    <tbody>
      {% for s in content.sources %}
      <tr{% if loop.first %} class="is-priority"{% endif %} id="cite-{{ s.ref }}">
        <td class="mono"><a class="cite-ref" href="#cite-{{ s.ref }}">{{ s.ref }}</a></td>
        <td>
          <a class="source-table__label" href="{{ s.url }}">{{ s.label }}</a>
          <span class="source-table__url">{{ s.url }}</span>
        </td>
        <td class="num">{{ s.cited_by | format_int }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="section-lede">{{ content.pages.sources.empty }}</p>
  {% endif %}
</section>
