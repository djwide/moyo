<section class="page page--sources" id="sources">
  <h2>{{ content.pages.sources.title or "What the models cited" }}</h2>
  {% if content.sources %}
  <p class="section-lede">{{ content.pages.sources.lede }}</p>
  <table class="source-table">
    <colgroup>
      <col class="col-ref" />
      <col class="col-label" />
      <col class="col-cited" />
    </colgroup>
    <thead>
      <tr>
        <th>Ref</th>
        <th>Source</th>
        <th>Findings</th>
      </tr>
    </thead>
    <tbody>
      {% for s in content.sources %}
      <tr{% if loop.first %} class="is-priority"{% endif %}>
        <td class="mono">{{ s.ref }}</td>
        <td>
          <span class="source-table__label">{{ s.label }}</span>
          {% if s.url %}<span class="source-table__url">{{ s.url }}</span>{% endif %}
        </td>
        <td class="num">{{ s.cited_by | format_int }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="section-lede">{{ content.pages.sources.empty }}</p>
  {% endif %}
</section>
