{% from "components/macros.j2" import section_head, svg_asset %}
{% set page = content.pages.model_comparison %}
{% set contrast = content.model_contrast or {} %}
<section class="page page--model-comparison" id="model-comparison">
  {{ section_head(page.title or "Cross-Model Comparison", page.takeaway, page.body or contrast.lede) }}

  {{ svg_asset(content.assets.model_heatmap, graphics.get('model_heatmap'), 'wide') }}
  {% if page.chart_caption %}<p class="chart-caption">{{ page.chart_caption }}</p>{% endif %}

  {% set common = contrast.commonality_prose or [] %}
  {% set diffs = contrast.differences_prose or [] %}
  <div class="contrast-split">
    <div class="contrast-col">
      <h3>Where the models agree</h3>
      <ul class="contrast-list">
        {% if common %}
          {% for line in common[:4] %}<li>{{ line | link_cites }}</li>{% endfor %}
        {% elif contrast.commonality %}
          {% for row in contrast.commonality[:4] %}
          <li>
            {{ row.claim | link_cites }}
            {% if row.models %}<span class="contrast-models">{{ row.models | join(', ') }}</span>{% endif %}
          </li>
          {% endfor %}
        {% else %}
          <li class="empty">No finding was stated by more than one model.</li>
        {% endif %}
      </ul>
    </div>
    <div class="contrast-col contrast-col--diff">
      <h3>Where they differ</h3>
      <ul class="contrast-list">
        {% if diffs %}
          {% for line in diffs[:4] %}<li>{{ line | link_cites }}</li>{% endfor %}
        {% elif contrast.differences %}
          {% for row in contrast.differences[:4] %}
          <li>
            {{ row.claim | link_cites }}
            {% if row.models %}<span class="contrast-models">{{ row.models | join(', ') }} · {{ row.evidence_status or row.kind }}</span>{% endif %}
          </li>
          {% endfor %}
        {% else %}
          <li class="empty">No single-model or contested leads in this run.</li>
        {% endif %}
      </ul>
    </div>
  </div>
</section>
