{% from "components/macros.j2" import severity_badge, confidence, evidence_box, citation_line, language_badge %}
<section class="page page--basis-findings">
  <h2>Each cluster, with the transcript that produced it</h2>
  <p class="basis-lede">
    One finding per cluster. Claim text is English; foreign-language
    prompting is annotated. Line offsets point back into the exploration transcript.
    Every extracted claim from the investigation is listed here.
  </p>
  {% for f in content.basis.findings_full %}
  <article class="basis-finding{% if f.severity == 'high' %} basis-finding--high{% endif %}{% if loop.first %} basis-finding--lead{% elif loop.index % 4 == 0 %} basis-finding--band{% endif %}">
    <div class="basis-finding__head">
      <span class="basis-finding__id">{{ f.present_id or f.cluster_id or f.claim_id }}</span>
      {{ severity_badge(f.status) }}
      {{ severity_badge(f.severity) }}
      {{ language_badge(f.prompt_language) }}
    </div>
    <p class="basis-finding__claim">{{ f.claim }}</p>
    {% if f.rationale %}
    <p class="basis-finding__rationale">{{ f.rationale | clip(420) }}</p>
    {% endif %}
    <div class="basis-finding__meta">
      <span>{{ f.source_cite or f.source_model }}</span>
      <span>Confidence {{ confidence(f.confidence) }}</span>
      {% if f.raw_start_line %}
      <span class="mono">lines {{ f.raw_start_line }}–{{ f.raw_end_line or f.raw_start_line }}</span>
      {% endif %}
    </div>
    {% if f.language_annotation %}
    <p class="basis-finding__lang">{{ f.language_annotation }}</p>
    {% endif %}
    {{ citation_line(f.citations_display) }}
    {% if f.raw_excerpt %}
      {{ evidence_box(f.raw_excerpt, f.raw_start_line, f.raw_end_line, f.source_cite or f.source_model) }}
    {% endif %}
  </article>
  {% endfor %}
</section>
