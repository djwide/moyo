{% from "components/macros.j2" import severity_badge, confidence, evidence_box, citation_line, language_badge %}
<section class="page page--basis-findings">
  <h2>Full Findings With Evidence</h2>
  <p class="basis-lede">
    One finding per collapsed exposure group, with severity, rationale,
    confidence, and the English evidence form (line offsets back into the
    exploration transcript). Multi-model paraphrases are merged; foreign-language
    prompting is annotated on the finding; claim text is always English.
  </p>
  {% for f in content.basis.findings_full %}
  <article class="basis-finding{% if f.severity == 'high' %} basis-finding--high{% endif %}">
    <div class="basis-finding__head">
      <span class="basis-finding__id">{{ f.claim_id }}</span>
      {{ severity_badge(f.status) }}
      {{ severity_badge(f.severity) }}
      {{ language_badge(f.prompt_language) }}
    </div>
    <p class="basis-finding__claim">{{ f.claim }}</p>
    <p class="basis-finding__rationale">{{ f.rationale }}</p>
    <div class="basis-finding__meta">
      <span>Source {{ f.source_cite or f.source_model }}</span>
      <span>Confidence {{ confidence(f.confidence) }}</span>
    </div>
    {% if f.language_annotation %}
    <p class="basis-finding__lang">{{ f.language_annotation }}</p>
    {% endif %}
    {{ citation_line(f.citations_display) }}
    {% if f.raw_excerpt %}
      {{ evidence_box(f.raw_excerpt, f.raw_start_line, f.raw_end_line, f.source_cite or f.source_model) }}
    {% endif %}
  </article>
  {% endfor %}
</section>
