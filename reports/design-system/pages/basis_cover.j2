{% from "components/macros.j2" import severity_badge %}
<section class="page page--cover">
  <header class="cover-header">
    <div class="cover-header__slot cover-header__slot--left">
      {% if logo_uri %}
      <img class="cover-header__logo cover-header__logo--moyo" src="{{ logo_uri }}" alt="MOYO" />
      {% endif %}
    </div>
    <div class="cover-header__slot cover-header__slot--right">
      {% if partner_logo_uri %}
      <img class="cover-header__logo cover-header__logo--partner" src="{{ partner_logo_uri }}" alt="SenTeGuard" />
      {% endif %}
    </div>
  </header>

  <div class="cover-body">
    <p class="cover-kicker">{{ content.meta.basis_kicker or "Basis report" }}</p>

    <div class="cover-lead">
      <p class="cover-prompt-label">Topic</p>
      <p class="cover-prompt">
        “{{ content.meta.display_topic or content.meta.topic or (content.meta.prompts[0] if content.meta.prompts else '') }}”
      </p>
      <p class="cover-date">{{ content.meta.report_date }}{% if content.meta.subject_detail %} · {{ content.meta.subject_detail }}{% endif %}</p>
    </div>

    <h1 class="cover-title">{{ content.meta.headline or "What the models disclosed" }}</h1>
    <p class="basis-lede">
      Full inventory, transcript excerpts, corroborating outputs, and how each
      conclusion was derived{% if content.meta.include_remediation %}, plus
      ISVF-mapped follow-up{% endif %}.
    </p>

    <div class="cover-meta">
      <section class="cover-meta__block">
        <h2 class="cover-meta__title">{{ content.meta.counts.llms_tested | format_int }} models on this run</h2>
        <ul class="cover-meta__list">
          {% for m in content.meta.models_tested %}
          <li>{{ m }}</li>
          {% else %}
          <li>{{ content.meta.counts.llms_tested | format_int }} models</li>
          {% endfor %}
        </ul>
      </section>
      <section class="cover-meta__block cover-meta__block--aside">
        <h2 class="cover-meta__title">Techniques</h2>
        <p class="cover-meta__techniques">
          {% for s in content.meta.strategies %}
            {{ s | sentence_case }}{% if not loop.last %} · {% endif %}
          {% endfor %}
        </p>
        {% if content.meta.fuzz_mode %}
        <p class="cover-meta__note">Fuzz mode {{ content.meta.fuzz_mode | sentence_case }}</p>
        {% endif %}
      </section>
    </div>
  </div>

  <footer class="cover-footer">
    <div class="cover-footer__stats">
      <span><strong>{{ content.meta.counts.findings | format_int }}</strong> findings</span>
      <span><strong>{{ content.meta.counts.llms_tested | format_int }}</strong> models</span>
      {% if content.meta.counts.high_sensitivity %}
      <span><strong>{{ content.meta.counts.high_sensitivity | format_int }}</strong> {{ (content.meta.priority_label or "high-sensitivity") | lower }}</span>
      {% endif %}
      <span><strong>{{ content.meta.counts.chains | format_int }}</strong> exposure chains</span>
      {% if content.meta.counts.languages %}
      <span><strong>{{ content.meta.counts.languages | format_int }}</strong> languages</span>
      {% endif %}
    </div>
  </footer>
</section>
