{% from "components/macros.j2" import section_head %}
{% set page = content.pages.executive_summary %}
<section class="page page--executive-summary" id="executive-summary">
  {{ section_head(page.title or "Executive Summary", page.takeaway) }}
  {% set blocks = page.blocks or [] %}
  {% if blocks %}
  <div class="exec-blocks">
    {% for block in blocks %}
    <section class="exec-block">
      <h3>{{ block.title }}</h3>
      <p>{{ block.body | link_cites }}</p>
    </section>
    {% endfor %}
  </div>
  {% else %}
  <p class="section-lede">{{ page.body | link_cites }}</p>
  {% endif %}

  {% set brief = content.meta.brief or {} %}
  {% if brief.kpis %}
  <dl class="kpi-row">
    {% for item in brief.kpis %}
    <div>
      <span class="kpi-row__value">{{ item.value | format_int }}</span>
      <span class="kpi-row__label">{{ item.label }}</span>
    </div>
    {% endfor %}
  </dl>
  {% endif %}
  {% if brief.secondary %}
  <dl class="kpi-tier">
    {% for item in brief.secondary %}
    <div>
      <span class="kpi-tier__value">{{ item.value | format_int }}</span>
      <span class="kpi-tier__label">{{ item.label }}</span>
    </div>
    {% endfor %}
  </dl>
  {% endif %}
  {% if content.meta.models_tested %}
  <p class="models-line">{{ content.meta.models_tested | join(' · ') }}</p>
  {% endif %}
</section>
