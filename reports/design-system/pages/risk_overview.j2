{% from "components/macros.j2" import section_head, svg_asset %}
{% set page = content.pages.risk_overview %}
{% set ov = content.overview or {} %}
<section class="page page--risk-overview" id="exposure-overview">
  {{ section_head(page.title or "Exposure Overview", page.takeaway, page.body) }}

  {% if ov.stats %}
  <dl class="stat-tiles">
    {% for item in ov.stats %}
    <div class="stat-tile">
      <dt class="stat-tile__label">{{ item.label }}</dt>
      <dd class="stat-tile__value">{{ item.value }}</dd>
      <dd class="stat-tile__note">{{ item.note }}</dd>
    </div>
    {% endfor %}
  </dl>
  {% endif %}

  <h3 class="chart-title">{{ page.chart_title or "Findings by model" }}</h3>
  {{ svg_asset(content.assets.findings_by_llm, graphics.get('findings_by_llm'), 'wide') }}

  {% if ov.rows %}
  <table class="data-table overview-table">
    <thead>
      <tr>
        <th>Model</th>
        <th class="num">Findings</th>
        <th class="num">High significance</th>
        <th class="num">Also stated by another model</th>
        <th class="num">Externally verified</th>
      </tr>
    </thead>
    <tbody>
      {% for row in ov.rows %}
      <tr>
        <td>{{ row.model }}</td>
        <td class="num">{{ row.findings | format_int }}</td>
        <td class="num">{{ row.high | format_int }}</td>
        <td class="num">{{ row.corroborated_pct }}%</td>
        <td class="num">{{ row.verified | format_int }} <span class="muted">({{ row.verified_pct }}%)</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
