{% from "components/macros.j2" import svg_asset, chart_caption %}
<section class="page page--risk-overview">
  <h2>{{ content.pages.risk_overview.title or "Which models disclosed the most" }}</h2>
  {% if content.pages.risk_overview.body %}
  <p class="section-lede">{{ content.pages.risk_overview.body }}</p>
  {% endif %}
  {% set caps = content.pages.risk_overview.chart_captions or {} %}
  <div class="risk-split">
    <div class="risk-split__primary">
      {{ svg_asset(content.assets.findings_by_llm, graphics.get('findings_by_llm'), 'compact findings-llm') }}
      {{ chart_caption(caps.get('findings_by_llm')) }}
    </div>
    <div class="risk-split__secondary">
      {{ svg_asset(content.assets.exposure_radar, graphics.get('exposure_radar'), 'compact') }}
      {{ chart_caption(caps.get('exposure_radar')) }}
    </div>
  </div>
</section>
