{% from "components/macros.j2" import source_refs %}
<section class="page page--basis-inventory">
  <h2>{{ content.pages.inventory.title | default("Every exposure group, ranked") }}</h2>
  <p class="basis-lede">
    One row per collapsed group, ranked by weighted exposure. Paraphrases from
    multiple models share a claim; corroboration counts distinct model outputs.
    Outliers, contested, and single-model disclosures stay in the table.
    S-numbers point to cited sources.
  </p>
  <table class="inventory-table">
    <colgroup>
      <col class="col-id" />
      <col class="col-claim" />
      <col class="col-category" />
      <col class="col-corrob" />
      <col class="col-source" />
    </colgroup>
    <thead>
      <tr>
        <th>ID</th>
        <th>Claim</th>
        <th>Category</th>
        <th class="num">Corrob.</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
      {% for row in content.basis.inventory %}
      <tr{% if loop.first %} class="is-priority"{% endif %}>
        <td class="mono">{{ row.claim_id }}</td>
        <td class="claim-cell">{{ row.claim }}</td>
        <td class="category-cell">{{ row.category | sentence_case }}</td>
        <td class="num">{{ row.corroboration | format_int }}</td>
        <td class="source-cell">
          <span class="source-cite">{{ row.source_cite }}</span>
          {{ source_refs(row.source_refs) }}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
