{% from "components/macros.j2" import severity_badge, source_refs %}
{# Expects ``parts`` = appendix TOC entries #}
{% set app = content.pages.appendix or {} %}
<section class="page page--appendix" id="appendix">
  <h2>{{ app.title or "Technical Appendix" }}</h2>
  {% if app.lede %}<p class="section-lede">{{ app.lede }}</p>{% endif %}
  {% if parts %}
  <ol class="appendix-outline">
    {% for part in parts %}
    <li><a href="#{{ part.id }}">{{ part.title }}</a></li>
    {% endfor %}
  </ol>
  {% endif %}

  <h3 class="appendix-part" id="inventory">{{ app.claims_title or "Complete Claim Inventory" }}</h3>
  {% if app.claims_body %}<p class="section-note">{{ app.claims_body }}</p>{% endif %}
  <table class="data-table inventory-table">
    <colgroup>
      <col class="col-id" />
      <col class="col-claim" />
      <col class="col-evidence" />
      <col class="col-sig" />
      <col class="col-models" />
    </colgroup>
    <thead>
      <tr>
        <th>ID</th>
        <th>Claim</th>
        <th>Evidence</th>
        <th>Significance</th>
        <th>Models</th>
      </tr>
    </thead>
    <tbody>
      {% for row in content.inventory or [] %}
      <tr>
        <td class="mono">{{ row.id }}</td>
        <td class="claim-cell">{{ row.claim | link_cites }} {{ source_refs(row.source_refs) }}</td>
        <td>{{ row.evidence_status }}</td>
        <td>{{ row.significance }}</td>
        <td>{{ row.models }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
