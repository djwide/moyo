{% from "components/macros.j2" import finding_block, facet_list %}
{% if content.unverified_findings %}
<section class="page page--unverified" id="unverified">
  <h2>{{ content.pages.unverified.title or "Single-model and unverified" }}</h2>
  <p class="section-lede">{{ content.pages.unverified.lede }}</p>
  {% for f in content.unverified_findings %}
    {{ finding_block(f, 'compact') }}
    {{ facet_list(f.facets) }}
  {% endfor %}
</section>
{% endif %}
