<section class="page page--contents">
  <h2>Contents</h2>
  <ol class="toc">
    {% for item in toc %}
    <li>
      <a href="#{{ item.id }}">{{ item.title }}</a>
      {% if item.children %}
      <ol class="toc toc--sub">
        {% for child in item.children %}
        <li>
          <a href="#{{ child.id }}">{{ child.title }}</a>
        </li>
        {% endfor %}
      </ol>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
</section>
