{% from "components/macros.j2" import toc_list %}
<section class="page page--cover">
  <header class="cover-header">
    <div class="cover-header__slot cover-header__slot--left">
      {% if logo_uri %}
      <img class="cover-header__logo cover-header__logo--moyo" src="{{ logo_uri }}" alt="MOYO" />
      {% endif %}
    </div>
    <div class="cover-header__slot cover-header__slot--right">
      {% if partner_logo_uri %}
      <img class="cover-header__logo cover-header__logo--partner" src="{{ partner_logo_uri }}" alt="SenTeGuard" />
      {% endif %}
    </div>
  </header>

  <div class="cover-body">
    {% if cover_kicker %}<p class="cover-kicker">{{ cover_kicker }}</p>{% endif %}
    <h1 class="cover-title">AI Exposure Assessment</h1>
    <p class="cover-subject">{{ content.meta.display_topic or content.meta.topic }}</p>
    <p class="cover-date">{{ content.meta.report_date }}</p>
    {% set brief = content.meta.brief or {} %}
    {% if brief.scan_line %}
    <p class="cover-scanline">{{ brief.scan_line }}</p>
    {% endif %}
  </div>

  {% if toc %}
  <nav class="page--contents cover-contents">
    <h2 class="cover-contents__title">Contents</h2>
    {{ toc_list(toc) }}
  </nav>
  {% endif %}
</section>
