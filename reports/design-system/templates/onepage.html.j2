{% from "components/macros.j2" import severity_badge, language_badge %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MOYO · Snapshot · {{ content.meta.topic }}</title>
  <link rel="icon" href="{{ favicon_uri }}" />
  <link rel="stylesheet" href="{{ css_href }}" />
</head>
<body>
  {# PDF snapshot: no hyperlinks — CTAs are plain text only. #}
  <article class="onepage">
    <header class="brand-bar">
      <div class="brand-bar__slot brand-bar__slot--left">
        {% if logo_uri %}
        <img class="logo" src="{{ logo_uri }}" alt="MOYO" />
        {% endif %}
      </div>
      <div class="brand-bar__slot brand-bar__slot--right">
        {% if partner_logo_uri %}
        <img class="logo logo--partner" src="{{ partner_logo_uri }}" alt="SenTeGuard" />
        {% endif %}
      </div>
    </header>

    <div class="snap-masthead">
      <div class="snap-masthead__stat">
        <div class="snap-masthead__value">{{ content.meta.counts.high_sensitivity | format_int }}</div>
        <div class="snap-masthead__label">High-sensitivity</div>
      </div>
      <div class="snap-masthead__copy">
        <p class="eyebrow">Exposure snapshot</p>
        <h1 class="headline">{{ content.meta.headline or "What the models disclosed" }}</h1>
        <p class="prompt-line">
          {% if content.meta.prompts and content.meta.prompts|length > 1 %}
            {% for p in content.meta.prompts %}
              “{{ p }}”{% if not loop.last %}; {% endif %}
            {% endfor %}
          {% else %}
            “{{ (content.meta.prompts[0] if content.meta.prompts else content.meta.topic) }}”
          {% endif %}
        </p>
        <p class="date-line">
          {{ content.meta.report_date }}
          {% if content.meta.generated_at %} · {{ content.meta.generated_at | format_timestamp }}{% endif %}
        </p>
      </div>
    </div>

    <div class="metrics">
      <div class="metric">
        <div class="value">{{ content.meta.counts.findings | format_int }}</div>
        <div class="label">Findings</div>
      </div>
      <div class="metric">
        <div class="value">{{ content.meta.counts.llms_tested | format_int }}</div>
        <div class="label">LLMs tested</div>
      </div>
      {% if content.meta.counts.chains %}
      <div class="metric">
        <div class="value">{{ content.meta.counts.chains | format_int }}</div>
        <div class="label">Chains</div>
      </div>
      {% endif %}
      {% if content.meta.counts.languages %}
      <div class="metric">
        <div class="value">{{ content.meta.counts.languages | format_int }}</div>
        <div class="label">Languages</div>
      </div>
      {% endif %}
    </div>

    <div class="snap-body">
      <section class="snap-body__lead">
        <h2>Lead disclosure</h2>
        <p class="lead-finding">{{ content.top_finding.text | clip(320) }}</p>
        <p class="badges">
          {% for b in content.top_finding.badges or [] %}
            {{ severity_badge(b) }}
          {% endfor %}
          {{ language_badge(content.top_finding.prompt_language) }}
        </p>
        {% if content.top_finding.language_annotation %}
        <p class="lead-lang">{{ content.top_finding.language_annotation }}</p>
        {% endif %}
        {% if content.pages.executive_summary.public_sources %}
        <p class="panel-sources">
          Cited: {{ content.pages.executive_summary.public_sources | join('; ') }}
        </p>
        {% endif %}
      </section>

      <section class="snap-body__rail">
        <h2>Highest-specificity claims</h2>
        <ul class="specific-list">
          {% for f in content.specific_findings[:4] %}
          <li>
            <span class="mono">{{ f.claim_id }}</span>
            {{ severity_badge('SPECIFIC') }}
            {% if f.status %}{{ severity_badge(f.status) }}{% endif %}
            <span class="specific-claim">{{ f.claim | clip(120) }}</span>
          </li>
          {% else %}
          <li class="empty">No high-specificity findings in this run.</li>
          {% endfor %}
        </ul>
      </section>
    </div>

    {% if content.onepage_more %}
    <section class="snap-more">
      <h2>Further disclosures</h2>
      <ul class="snap-more-list">
        {% for f in content.onepage_more[:6] %}
        <li>
          <span class="mono">{{ f.claim_id }}</span>
          {% if f.status %}{{ severity_badge(f.status) }}{% endif %}
          {{ f.claim | clip(110) }}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </article>
</body>
</html>
