{% from "components/macros.j2" import severity_badge, language_badge %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MOYO · Snapshot · {{ content.meta.topic }}</title>
  <link rel="icon" href="{{ favicon_uri }}" />
  <link rel="stylesheet" href="{{ css_href }}" />
</head>
<body>
  {# PDF snapshot: no hyperlinks — CTAs are plain text only. #}
  {% set sheet = content.onepage if content.onepage is defined and content.onepage else {} %}
  <article class="onepage">
    <header class="brand-bar">
      <div class="brand-bar__slot brand-bar__slot--left">
        {% if logo_uri %}
        <img class="logo" src="{{ logo_uri }}" alt="MOYO" />
        {% endif %}
      </div>
      <div class="brand-bar__slot brand-bar__slot--right">
        {% if partner_logo_uri %}
        <img class="logo logo--partner" src="{{ partner_logo_uri }}" alt="SenTeGuard" />
        {% endif %}
      </div>
    </header>

    <div class="snap-masthead">
      <p class="eyebrow">AI Exposure Assessment</p>
      <h1 class="headline">{{ sheet.headline or content.meta.headline or content.meta.topic }}</h1>
      <p class="subject">{{ sheet.subject or content.meta.display_topic or content.meta.topic }}</p>
      {% if sheet.meta_line %}
      <p class="models-line">{{ sheet.meta_line }}</p>
      {% else %}
      <p class="models-line">{{ content.meta.report_date }}{% if content.meta.models_tested %} · {{ content.meta.models_tested | join(' · ') }}{% endif %}</p>
      {% endif %}
      {% if sheet.volume_line %}
      <p class="volume-line">{{ sheet.volume_line }}</p>
      {% endif %}
    </div>

    {% if sheet.kpis %}
    <div class="metrics">
      {% for item in sheet.kpis %}
      <div class="metric">
        <div class="value">{{ item.value | format_int }}</div>
        <div class="label">{{ item.label }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="snap-split">
      <section class="snap-split__col">
        <h2>Priority findings with source support</h2>
        <ul class="finding-rows">
          {% for f in sheet.priority or [] %}
          <li>
            <p class="chips">
              <span class="chip">{{ f.evidence }}</span>
              <span class="chip chip--sig">{{ f.significance }}</span>
              <span class="chip chip--models">{{ f.models_label }}</span>
            </p>
            <p class="row-claim">{{ f.claim }}</p>
          </li>
          {% else %}
          <li class="empty">No source-linked findings meet the significance threshold.</li>
          {% endfor %}
        </ul>
      </section>
      <section class="snap-split__col snap-split__col--queue">
        <h2>Research queue</h2>
        <ul class="finding-rows">
          {% for f in sheet.queue or [] %}
          <li>
            <p class="chips">
              <span class="chip">{{ f.evidence }}</span>
              <span class="chip chip--sig">{{ f.significance }}</span>
              <span class="chip chip--models">{{ f.models_label }}</span>
            </p>
            <p class="row-claim">{{ f.claim }}</p>
          </li>
          {% else %}
          <li class="empty">No high-significance findings are still unvalidated inferences.</li>
          {% endfor %}
        </ul>
      </section>
    </div>

    <footer class="snap-foot">
      <div class="snap-foot__col">
        <h2>Evidence profile</h2>
        <p>{{ sheet.profile }}</p>
      </div>
      <div class="snap-foot__col">
        <h2>Coverage</h2>
        <p>{{ sheet.coverage }}</p>
        {% if content.meta.models_tested %}
        <p class="foot-models">{{ content.meta.models_tested | join(' · ') }}</p>
        {% endif %}
      </div>
      <div class="snap-foot__col">
        <h2>Important limitation</h2>
        <p>Unvalidated inferences are not factual validation.</p>
      </div>
      <p class="method-note">{{ sheet.method }}</p>
    </footer>
  </article>
</body>
</html>
