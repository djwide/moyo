{% from "components/macros.j2" import severity_badge, language_badge %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MOYO · Snapshot · {{ content.meta.topic }}</title>
  <link rel="icon" href="{{ favicon_uri }}" />
  <link rel="stylesheet" href="{{ css_href }}" />
</head>
<body>
  {# PDF snapshot: no hyperlinks — CTAs are plain text only. #}
  <article class="onepage">
    <header class="brand-bar">
      <div class="brand-bar__slot brand-bar__slot--left">
        {% if logo_uri %}
        <img class="logo" src="{{ logo_uri }}" alt="MOYO" />
        {% endif %}
      </div>
      <div class="brand-bar__slot brand-bar__slot--right">
        {% if partner_logo_uri %}
        <img class="logo logo--partner" src="{{ partner_logo_uri }}" alt="SenTeGuard" />
        {% endif %}
      </div>
    </header>

    <div class="snap-masthead">
      <div class="snap-masthead__stat">
        <div class="snap-masthead__value">{{ content.meta.counts.high_sensitivity | format_int }}</div>
        <div class="snap-masthead__label">{{ content.meta.priority_label or "High-sensitivity" }}</div>
      </div>
      <div class="snap-masthead__copy">
        <p class="eyebrow">{{ content.meta.eyebrow or "Exposure snapshot" }}</p>
        <h1 class="headline">{{ content.meta.headline or "What the models disclosed" }}</h1>
        <p class="prompt-line">
          “{{ content.meta.display_topic or content.meta.topic or (content.meta.prompts[0] if content.meta.prompts else '') }}”
        </p>
        <p class="date-line">
          {{ content.meta.report_date }}
          {% if content.meta.subject_detail %} · {{ content.meta.subject_detail }}{% endif %}
        </p>
        {% if content.meta.models_tested %}
        <p class="models-line">
          {{ content.meta.models_tested | join(' · ') }}
        </p>
        {% endif %}
      </div>
    </div>

    <div class="metrics">
      <div class="metric">
        <div class="value">{{ content.meta.counts.findings | format_int }}</div>
        <div class="label">Findings</div>
      </div>
      <div class="metric">
        <div class="value">{{ content.meta.counts.llms_tested | format_int }}</div>
        <div class="label">LLMs tested</div>
      </div>
      {% if content.meta.counts.chains %}
      <div class="metric">
        <div class="value">{{ content.meta.counts.chains | format_int }}</div>
        <div class="label">Chains</div>
      </div>
      {% endif %}
      {% if content.meta.counts.languages %}
      <div class="metric">
        <div class="value">{{ content.meta.counts.languages | format_int }}</div>
        <div class="label">Languages</div>
      </div>
      {% endif %}
    </div>

    {% if content.meta.audience == 'opposition' %}
    <div class="snap-split">
      <section class="snap-split__col">
        <h2>Verified</h2>
        {% if content.onepage_verified %}
        {% set lead = content.onepage_verified[0] %}
        <p class="lead-finding">{{ lead.claim }}{% if lead.provenance %} — {{ lead.provenance }}{% endif %}</p>
        <ul class="specific-list">
          {% for f in content.onepage_verified[1:] %}
          <li>
            <div class="snap-item__title">
              <span class="mono">{{ f.present_id or f.claim_id }}</span>
              {% if f.status_label or f.status %}{{ severity_badge(f.status_label or f.status) }}{% endif %}
            </div>
            <p class="specific-claim">{{ f.claim }}{% if f.provenance %} — {{ f.provenance }}{% endif %}</p>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty">No verified findings in this run.</p>
        {% endif %}
      </section>
      <section class="snap-split__col snap-split__col--verify">
        <h2>Requires further verification</h2>
        {% if content.onepage_needs_verification %}
        {% set lead = content.onepage_needs_verification[0] %}
        <p class="lead-finding">{{ lead.claim }}{% if lead.provenance %} — {{ lead.provenance }}{% endif %}</p>
        <ul class="specific-list">
          {% for f in content.onepage_needs_verification[1:] %}
          <li>
            <div class="snap-item__title">
              <span class="mono">{{ f.present_id or f.claim_id }}</span>
              {% if f.status_label or f.status %}{{ severity_badge(f.status_label or f.status) }}{% endif %}
            </div>
            <p class="specific-claim">{{ f.claim }}{% if f.provenance %} — {{ f.provenance }}{% endif %}</p>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty">No claims require further verification.</p>
        {% endif %}
      </section>
    </div>
    {% else %}
    <div class="snap-body">
      <section class="snap-body__lead">
        <h2>
          Lead Disclosure
          {% for b in content.top_finding.badges or [] %}
            {{ severity_badge(b) }}
          {% endfor %}
          {{ language_badge(content.top_finding.prompt_language) }}
        </h2>
        <p class="lead-finding">{{ content.top_finding.text }}{% if content.top_finding.provenance %} — {{ content.top_finding.provenance }}{% endif %}</p>
        {% if content.pages.executive_summary.public_sources %}
        <p class="panel-sources">
          Cited: {{ content.pages.executive_summary.public_sources | join('; ') }}
        </p>
        {% endif %}
      </section>

      <section class="snap-body__rail">
        <h2>Highest-Specificity Claims</h2>
        <ul class="specific-list">
          {% for f in content.specific_findings[:4] %}
          <li>
            <div class="snap-item__title">
              <span class="mono">{{ f.present_id or f.claim_id }}</span>
              {{ severity_badge('SPECIFIC') }}
              {% if f.status_label or f.status %}{{ severity_badge(f.status_label or f.status) }}{% endif %}
            </div>
            <p class="specific-claim">{{ f.claim }}{% if f.provenance %} — {{ f.provenance }}{% endif %}</p>
          </li>
          {% else %}
          <li class="empty">No sourced corroborated findings in this run.</li>
          {% endfor %}
        </ul>
      </section>
    </div>

    {% if content.onepage_more %}
    <section class="snap-more">
      <h2>Further Disclosures</h2>
      <ul class="snap-more-list">
        {% for f in content.onepage_more[:6] %}
        <li>
          <div class="snap-item__title">
            <span class="mono">{{ f.present_id or f.claim_id }}</span>
            {% if f.status_label or f.status %}{{ severity_badge(f.status_label or f.status) }}{% endif %}
          </div>
          <p class="snap-more-claim">{{ f.claim }}{% if f.provenance %} — {{ f.provenance }}{% endif %}</p>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {% endif %}
  </article>
</body>
</html>
