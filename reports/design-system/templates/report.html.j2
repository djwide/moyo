<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MOYO · {{ content.meta.topic }}</title>
  <link rel="icon" href="{{ favicon_uri }}" />
  <link rel="stylesheet" href="{{ css_href }}" />
</head>
<body>
  {% set pages = content.pages %}
  {% set plan = (content.next_steps or {}).snapshot or {} %}
  {% set ns = namespace(parts=[
    {"id": "inventory", "title": "A · " ~ (pages.appendix.claims_title or "Complete Claim Inventory")},
  ]) %}
  {% if content.model_dossiers %}
    {% set ns.parts = ns.parts + [{"id": content.model_dossiers[0].id, "title": "B · " ~ ((pages.model_dossiers or {}).title or "Model Dossiers")}] %}
  {% endif %}
  {% set ns.parts = ns.parts + [
    {"id": "sources", "title": "C · " ~ (pages.sources.title or "Cited Sources")},
    {"id": "glossary", "title": "D · " ~ (pages.glossary.title or "Glossary")},
  ] %}
  {% set toc = [
    {"id": "executive-summary", "title": pages.executive_summary.title or "Executive Summary"},
    {"id": "exposure-overview", "title": pages.risk_overview.title or "Exposure Overview"},
    {"id": "priority-leads", "title": (pages.brief_findings or {}).title or "Priority Leads"},
    {"id": "evidence", "title": pages.evidence.title or "Evidence and Source Quality"},
    {"id": "model-comparison", "title": pages.model_comparison.title or "Cross-Model Comparison"},
    {"id": "next-steps", "title": plan.title or "Verification Plan"},
    {"id": "methodology", "title": (pages.methodology or {}).title or "Methodology and Limitations"},
    {"id": "appendix", "title": pages.appendix.title or "Technical Appendix", "part": true, "children": ns.parts},
  ] %}
  {% include "pages/cover.j2" %}
  {% include "pages/executive_summary.j2" %}
  {% include "pages/risk_overview.j2" %}
  {% include "pages/brief_findings.j2" %}
  {% include "pages/evidence.j2" %}
  {% include "pages/model_comparison.j2" %}
  {% with section = plan %}
  {% include "pages/next_steps.j2" %}
  {% endwith %}
  {% include "pages/methodology.j2" %}
  {% with parts = ns.parts %}
  {% include "pages/appendix.j2" %}
  {% endwith %}
  {% for dossier in content.model_dossiers or [] %}
    {% with depth = "snapshot" %}
    {% include "pages/model_dossier.j2" %}
    {% endwith %}
  {% endfor %}
  {% include "pages/sources.j2" %}
  {% include "pages/glossary.j2" %}
</body>
</html>
