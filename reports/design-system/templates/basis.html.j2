<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MOYO Basis Report · {{ content.meta.topic }}</title>
  <link rel="icon" href="{{ favicon_uri }}" />
  <link rel="stylesheet" href="{{ css_href }}" />
</head>
<body>
  {% include "pages/basis_cover.j2" %}
  {% set ns = namespace(toc=[
    {"id": "executive-summary", "title": content.pages.executive_summary.title or "Disclosure Summary"},
    {"id": "risk-overview", "title": content.pages.risk_overview.title or "Model Exposure"},
    {"id": "model-comparison", "title": content.pages.model_comparison.title or "Model Comparison"},
    {"id": "inventory", "title": content.pages.inventory.title or "Cluster Inventory"},
    {"id": "findings", "title": (content.pages.basis_findings or {}).title or "Cluster Transcripts"},
    {"id": "exposure", "title": (content.pages.exposure or {}).title or "Exposure Chains"},
  ], model_kids=[]) %}
  {% for d in content.model_dossiers or [] %}
    {% set ns.model_kids = ns.model_kids + [{"id": d.id, "title": d.model}] %}
  {% endfor %}
  {% if content.unverified_findings %}
    {% set ns.toc = ns.toc[:5] + [{"id": "unverified", "title": content.pages.unverified.title or "Single-model and unverified"}] + ns.toc[5:] %}
  {% endif %}
  {% if ns.model_kids %}
    {% set ns.toc = ns.toc + [{
      "id": ns.model_kids[0].id,
      "title": (content.pages.model_dossiers or {}).title or "Model Dossiers",
      "children": ns.model_kids,
    }] %}
  {% endif %}
  {% if content.meta.include_remediation %}
    {% set ns.toc = ns.toc + [{"id": "remediation", "title": (content.pages.remediation or {}).title or "Matching Controls"}] %}
  {% endif %}
  {% if content.next_steps and content.next_steps.basis %}
    {% set ns.toc = ns.toc + [{
      "id": "next-steps",
      "title": content.next_steps.basis.title or "Follow-Up Plan",
    }] %}
  {% endif %}
  {% set ns.toc = ns.toc + [
    {"id": "sources", "title": content.pages.sources.title or "Cited Sources"},
    {"id": "glossary", "title": content.pages.glossary.title or "Score Glossary"},
    {"id": "appendix", "title": (content.pages.appendix or {}).title or "Appendix", "children": [
      {"id": "appendix-method", "title": (content.pages.appendix or {}).method_title or "Collection Method"},
    ]},
  ] %}
  {% with toc = ns.toc %}
  {% include "pages/contents.j2" %}
  {% endwith %}
  {% include "pages/executive_summary.j2" %}
  {% include "pages/risk_overview.j2" %}
  {% include "pages/model_comparison.j2" %}
  {% include "pages/basis_inventory.j2" %}
  {% include "pages/basis_findings.j2" %}
  {% include "pages/unverified.j2" %}
  {% include "pages/basis_exposure.j2" %}
  {% for dossier in content.model_dossiers or [] %}
    {% with depth = "basis" %}
    {% include "pages/model_dossier.j2" %}
    {% endwith %}
    {% include "pages/model_dossier_detail.j2" %}
  {% endfor %}
  {% if content.meta.include_remediation %}
  {% include "pages/basis_remediation.j2" %}
  {% endif %}
  {% if content.next_steps and content.next_steps.basis %}
  {% with section = content.next_steps.basis %}
  {% include "pages/next_steps.j2" %}
  {% endwith %}
  {% endif %}
  {% include "pages/sources.j2" %}
  {% include "pages/glossary.j2" %}
  {% include "pages/basis_appendix.j2" %}
</body>
</html>
