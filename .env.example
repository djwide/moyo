# Example environment configuration for moyo.
# Copy to `.env` and adjust. All values are optional; defaults are shown.
# Settings are read from defaults -> .env -> MOYO_* environment variables.

# --- Core ---
MOYO_ENVIRONMENT=development        # development | staging | production
MOYO_DEBUG=false
MOYO_DATA_DIR=data
MOYO_INDEX_DIR=indexes
MOYO_CACHE_DIR=cache
MOYO_OUTPUT_DIR=output

# --- Logging (MOYO_LOG_*) ---
MOYO_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
MOYO_LOG_STRUCTURED=true
# MOYO_LOG_FILE_PATH=logs/moyo.log

# --- Prometheus metrics (MOYO_PROMETHEUS_*) ---
MOYO_PROMETHEUS_ENABLED=true
MOYO_PROMETHEUS_PORT=8000

# --- Embedding model (MOYO_EMBEDDING_*) ---
# See docs/embeddings.md for model tier recommendations.
MOYO_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MOYO_EMBEDDING_DEVICE=auto          # auto | cuda | cpu  (auto uses CUDA when available)
# MOYO_EMBEDDING_BATCH_SIZE=32

# --- FAISS (MOYO_FAISS_*) ---
MOYO_FAISS_INDEX_TYPE=FlatL2
MOYO_FAISS_DIMENSION=384

# --- Pipeline (MOYO_PIPELINE_*) ---
MOYO_PIPELINE_CHUNK_SIZE=512
MOYO_PIPELINE_OVERLAP=50

# --- Default LLM (MOYO_LLM_*) -------------------------------------------------
# The single "default" LLM used for prompt rewording and summary synthesis.
# Change these four lines to hot-swap the default model everywhere in moyo.
MOYO_LLM_PROVIDER=openai            # openai | anthropic | ollama | custom | echo
MOYO_LLM_MODEL=gpt-4o
# MOYO_LLM_API_KEY=                 # falls back to the provider key below if unset
# MOYO_LLM_BASE_URL=                # required only for provider=custom or ollama
# Example: make Grok the default ->
#   MOYO_LLM_PROVIDER=custom
#   MOYO_LLM_MODEL=grok-4.5
#   MOYO_LLM_API_KEY=<your xAI key>
#   MOYO_LLM_BASE_URL=https://api.x.ai/v1
# Example: make local Ollama the default ->
#   MOYO_LLM_PROVIDER=ollama
#   MOYO_LLM_MODEL=llama3.1:8b
#   MOYO_LLM_BASE_URL=http://127.0.0.1:11434
# Ollama must be running (ollama serve). On WSL without systemd, add to ~/.bashrc:
#   if ! curl -sf http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
#     nohup ollama serve > /tmp/ollama.log 2>&1 &
#   fi
# See docs/configuration_and_monitoring_summary.md (Local Ollama setup).

# --- LLM provider API keys ----------------------------------------------------
# Referenced by config/retrieval_llms.json as $VAR. Fill in the ones you use.
# OPENAI_API_KEY=sk-...             # ChatGPT / OpenAI
# ANTHROPIC_API_KEY=sk-ant-...      # Claude / Anthropic
# XAI_API_KEY=xai-...               # Grok / xAI            (base https://api.x.ai/v1)
# GEMINI_API_KEY=...                # Gemini / Google       (base .../v1beta/openai/)
# DASHSCOPE_API_KEY=sk-...          # Qwen / Alibaba        (base dashscope-intl .../compatible-mode/v1)
# MOONSHOT_API_KEY=sk-...           # Kimi / Moonshot       (base https://api.moonshot.ai/v1)
# OPENROUTER_API_KEY=sk-or-...      # OpenRouter (many models) (base https://openrouter.ai/api/v1)
# Ollama is local and needs no key (default http://localhost:11434).

# --- Red-team LLM keys --------------------------------------------------------
# MOYO_TARGET_API_KEY=...           # red-team target LLM
# MOYO_HELPER_API_KEY=...           # red-team helper LLM
